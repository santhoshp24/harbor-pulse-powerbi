	column 'Era Sort'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 741d3e09-5d3b-5f85-9bdf-6d38b750d24c
		summarizeBy: none
		sourceColumn: Era Sort

		annotation SummarizationSetBy = Automatic

	partition Calendar = m
		mode: import
		source =
				let
				    StartDate = #date(1995, 1, 1),
				    EndDate = #date(2026, 12, 31),
				    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
				    Base = Table.FromList(Dates, Splitter.SplitByNothing(), type table [Date = date]),
				    AddYear = Table.AddColumn(Base, "Year", each Date.Year([Date]), Int64.Type),
				    AddMonthNumber = Table.AddColumn(AddYear, "Month Number", each Date.Month([Date]), Int64.Type),
				    AddMonth = Table.AddColumn(AddMonthNumber, "Month", each Date.ToText([Date], "MMM", "en-US"), type text),
				    AddQuarter = Table.AddColumn(AddMonth, "Quarter", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
				    AddMonthStart = Table.AddColumn(AddQuarter, "Month Start", each Date.StartOfMonth([Date]), type date),
				    AddYearMonth = Table.AddColumn(AddMonthStart, "Year Month", each Date.ToText([Date], "MMM yyyy", "en-US"), type text),
				    AddYearMonthSort = Table.AddColumn(AddYearMonth, "Year Month Sort", each Date.Year([Date]) * 100 + Date.Month([Date]), Int64.Type),
				    AddDecade = Table.AddColumn(AddYearMonthSort, "Decade", each Text.From(Number.IntegerDivide(Date.Year([Date]), 10) * 10) & "s", type text),
				    AddEra = Table.AddColumn(AddDecade, "Era", each if Date.Year([Date]) < 2020 then "Pre-COVID" else if Date.Year([Date]) <= 2021 then "COVID" else "Recovery", type text),
				    AddEraSort = Table.AddColumn(AddEra, "Era Sort", each if Date.Year([Date]) < 2020 then 1 else if Date.Year([Date]) <= 2021 then 2 else 3, Int64.Type)
				in
				    AddEraSort

	annotation PBI_ResultType = Table

