model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["CsvFolder","Arrivals","Calendar","Vessel Type","Metric","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table Arrivals
ref table Calendar
ref table 'Vessel Type'
ref table Metric
ref table _Measures

ref cultureInfo en-US

