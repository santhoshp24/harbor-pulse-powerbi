{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "trendChart",
  "position": {
    "x": 248,
    "y": 200,
    "z": 22000,
    "height": 264,
    "width": 652,
    "tabOrder": 22000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendar"
                    }
                  },
                  "Property": "Month Start"
                }
              },
              "queryRef": "Calendar.Month Start",
              "nativeQueryRef": "Month Start",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Selected Metric"
                }
              },
              "queryRef": "_Measures.Selected Metric",
              "nativeQueryRef": "Selected Metric",
              "displayName": "Monthly"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Selected Metric 12M Avg"
                }
              },
              "queryRef": "_Measures.Selected Metric 12M Avg",
              "nativeQueryRef": "Selected Metric 12M Avg",
              "displayName": "12-month avg"
            }
          ]
        }
      }
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#3A4160'"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "metadata": "_Measures.Selected Metric"
          }
        },
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#7C83FF'"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "metadata": "_Measures.Selected Metric 12M Avg"
          }
        }
      ],
      "lineStyles": [
        {
          "properties": {
            "strokeWidth": {
              "expr": {
                "Literal": {
                  "Value": "1D"
                }
              }
            },
            "lineChartType": {
              "expr": {
                "Literal": {
                  "Value": "'linear'"
                }
              }
            }
          },
          "selector": {
            "metadata": "_Measures.Selected Metric"
          }
        },
        {
          "properties": {
            "strokeWidth": {
              "expr": {
                "Literal": {
                  "Value": "2.5D"
                }
              }
            },
            "lineChartType": {
              "expr": {
                "Literal": {
                  "Value": "'smooth'"
                }
              }
            },
            "showMarker": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          },
          "selector": {
            "metadata": "_Measures.Selected Metric 12M Avg"
          }
        }
      ],
      "categoryAxis": [
        {
          "properties": {
            "axisType": {
              "expr": {
                "Literal": {
                  "Value": "'Scalar'"
                }
              }
            },
            "gridlineShow": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "legend": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "position": {
              "expr": {
                "Literal": {
                  "Value": "'TopRight'"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Trend Title"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Grey: each month. Indigo: 12-month rolling average'"
                }
              }
            }
          }
        }
      ],
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Monthly trend of the selected metric with 12-month rolling average'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}